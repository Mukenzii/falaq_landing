# Copy to .env and change the values. .env stays on this machine; it is never committed.

# Port the site is published on with docker compose: http://localhost:8080
PORT=8080

# Uzum Seller API key for `npm run sync:uzum`: seller.uzum.uz → Settings → API keys
# (paste it without "Bearer"). Used only by the sync script on this machine; the site
# itself never sees it.
UZUM_API_KEY=
# Optional: which shop to read if the key sees several (Falaq_Nashr is 129279)
UZUM_SHOP_ID=129279

# Google Sheet with the bookshops ("Do'kon lokatsiya") for `npm run sync:stores`: the long ID in
# the sheet's link, docs.google.com/spreadsheets/d/<ID>/edit. The sheet must be shared as
# "anyone with the link can view". Kept here, not in the code, because the sheet has more
# columns (agents, contacts) than the site shows.
SHEET_ID=
