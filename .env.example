# Copy to .env and change the values.
ADMIN_PASSWORD=change-me
# Any long random string; signs admin sessions. Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
POSTGRES_PASSWORD=falaq
# Port the site is published on: http://localhost:8080
PORT=8080
# 1 = run the Uzum sync once on first start when no products are stored yet
SYNC_ON_START=1
# Uzum Seller API key: seller.uzum.uz → Settings → API keys (paste it without "Bearer").
# When set, the admin "Uzumdan yangilash" button reads products through the official API;
# when empty or failing, it reads the public shop page instead.
UZUM_API_KEY=
# Optional: which shop to read if the key sees several (Falaq_Nashr is 129279)
UZUM_SHOP_ID=129279
